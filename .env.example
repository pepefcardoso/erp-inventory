# --- Docker Compose / PostgreSQL ---
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NOTE: POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB only take effect
# on first container start (when the pgdata volume is empty).
# If you change them later, drop the volume first:
#   docker compose down -v

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=erp_inventory
